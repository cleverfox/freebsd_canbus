+/*
+ * FreeBSD compatibility shim for can-utils, force-included via -include.
+ * Bridges the Linux-isms the RAW CAN tools rely on.
+ */
+#ifndef _FBSD_CANUTILS_COMPAT_H_
+#define _FBSD_CANUTILS_COMPAT_H_
+
+
+#include <net/if.h>
+#include <sys/socket.h>
+
+/* Linux struct ifreq has ifr_ifindex; FreeBSD spells it ifr_index. */
+#ifndef ifr_ifindex
+#define ifr_ifindex ifr_index
+#endif
+
+/* Linux-only socket options: degrade to portable equivalents / no-ops. */
+#ifndef SO_RCVBUFFORCE
+#define SO_RCVBUFFORCE SO_RCVBUF
+#endif
+#ifndef SO_RXQ_OVFL
+#define SO_RXQ_OVFL 0x4040	/* unsupported on FreeBSD; compile-only */
+#endif
+
+#ifndef SO_TXTIME
+#define SO_TXTIME 0x4041
+#endif
+#ifndef SO_MARK
+#define SO_MARK 0x4042
+#endif
+
+#ifndef SO_PRIORITY
+#define SO_PRIORITY 0x4043
+#endif
+#ifndef SCM_TXTIME
+#define SCM_TXTIME SO_TXTIME
+#endif
+
+#ifndef MSG_CONFIRM
+#define MSG_CONFIRM 0	/* Linux send flag; no-op on FreeBSD */
+#endif
+
+#endif
