@@ -0,0 +1,27 @@
+#!/bin/sh
+# Build the RAW-CAN can-utils tools on FreeBSD against the netcan stack.
+# Requires: libepoll-shim (pkg), the netcan kernel module (can.ko) for runtime.
+set -e
+cd "$(dirname "$0")"
+CC=${CC:-cc}
+CF="-O2 -Wall -Iinclude -Icompat -include $PWD/compat/compat.h -I/usr/local/include/libepoll-shim"
+LD="-L/usr/local/lib -lepoll-shim"
+
+$CC $CF -c lib.c -o lib.o
+$CC $CF -c canframelen.c -o canframelen.o
+
+# RAW(CAN_RAW)-only tools. Protocol tools (isotp*/j1939*/bcm*/cangw/slcan*)
+# need kernel protocols not present on FreeBSD and are intentionally skipped.
+TOOLS="cansend candump cangen canplayer cansniffer canbusload canlogserver \
+       canerrsim canfdtest asc2log log2asc canmakelog canframelentest canlogtest"
+ok=""; fail=""
+for t in $TOOLS; do
+	[ -f "$t.c" ] || continue
+	if $CC $CF -o "$t" "$t.c" lib.o canframelen.o $LD 2>"/tmp/$t.buildlog"; then
+		ok="$ok $t"
+	else
+		fail="$fail $t"
+	fi
+done
+echo "BUILT:$ok"
+echo "SKIPPED/FAILED:$fail"
